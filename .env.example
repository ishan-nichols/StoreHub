# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://storehub:storehub@localhost:5432/storehub

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for rate limiting and job queues. Falls back to in-memory if not set.
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTES_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_DIFFERENT_RANDOM_32_BYTES_HEX
# Must be exactly 32 characters
MFA_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_KEY_FOR_TOTP_!!

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all (dev only).
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave unset in dev — emails are logged to console instead of sent.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# EMAIL_FROM=StoreHub <noreply@yourdomain.com>

# ─── App URL (used in email links) ────────────────────────────────────────────
APP_URL=http://localhost:5173

# ─── AI (optional) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-key

# ─── Docker Compose (only needed for docker-compose.yml) ─────────────────────
POSTGRES_USER=storehub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=storehub
HTTP_PORT=80
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
