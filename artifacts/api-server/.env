# ─── Required ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL from https://neon.tech (free tier, no card needed)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storehub

# ─── JWT Secrets (change these to random strings in production) ───────────────
JWT_SECRET=storehub-local-secret-change-me
JWT_REFRESH_SECRET=storehub-local-refresh-secret-change-me

# ─── AI (optional — AI chat/insights/vision won't work without real keys) ────
# OpenAI: get a key at https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-placeholder

# Anthropic: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-placeholder

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# ALLOWED_ORIGINS=http://localhost:5173   # uncomment & set for production only
